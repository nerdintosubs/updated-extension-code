{
  "name": "ou-link-validator-devtools",
  "version": "1.2.4",
  "private": true,
  "description": "Dev tooling for OU Link Validator (tests/lint/ci).",
  "type": "module",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,md,yml,yaml}\"",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --coverage",
    "test:ci": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --ci --coverage",
    "prepare": "husky install ../.husky",
    "package:zip": "powershell -NoProfile -ExecutionPolicy Bypass -File ../scripts/package.ps1"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {},
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text",
      "lcov",
      "cobertura"
    ],
    "reporters": [
      "default",
      [
        "jest-junit",
        {
          "outputDirectory": "../test-results",
          "outputName": "junit.xml",
          "ancestorSeparator": " : "
        }
      ]
    ],
    "coverageThreshold": {
      "global": {
        "branches": 85,
        "functions": 90,
        "lines": 90,
        "statements": 90
      }
    }
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,md,yml,yaml}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "19.5.0",
    "@commitlint/config-conventional": "19.5.0",
    "eslint": "8.57.0",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-import": "2.32.0",
    "husky": "9.1.7",
    "jest": "29.7.0",
    "jest-junit": "^16.0.0",
    "jsdom": "24.0.0",
    "lint-staged": "15.2.10",
    "prettier": "3.3.3"
  }
}
